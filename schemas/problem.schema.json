{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "leetcode-daily-cheatsheet/problem.schema.json",
  "title": "NormalizedProblem",
  "description": "A LeetCode problem after src/leetcode/parser.py has stripped HTML and normalized it. This is the only representation Claude ever sees.",
  "type": "object",
  "required": [
    "date",
    "number",
    "title",
    "slug",
    "difficulty",
    "statement",
    "examples",
    "constraints"
  ],
  "additionalProperties": false,
  "properties": {
    "date": { "type": "string", "format": "date" },
    "number": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "difficulty": { "type": "string", "enum": ["Easy", "Medium", "Hard"] },
    "url": { "type": "string", "format": "uri" },
    "topics": {
      "type": "array",
      "items": { "type": "string" }
    },
    "statement": {
      "type": "string",
      "description": "Plain-text (HTML stripped) problem statement.",
      "minLength": 1
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["input", "output"],
        "additionalProperties": false,
        "properties": {
          "input": { "type": "string" },
          "output": { "type": "string" },
          "explanation": { "type": "string" }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "python_template": {
      "type": "string",
      "description": "The starter code snippet LeetCode provides for Python 3, if available."
    },
    "is_premium": { "type": "boolean", "default": false },
    "similar_questions": {
      "type": "array",
      "description": "Best-effort 'related problems' from LeetCode's similarQuestions field (see src/leetcode/client.py). Empty when unavailable/unparseable -- never blocks a run.",
      "items": {
        "type": "object",
        "required": ["title", "slug", "difficulty"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string" },
          "slug": { "type": "string" },
          "difficulty": { "type": "string", "enum": ["Easy", "Medium", "Hard"] }
        }
      }
    }
  }
}
