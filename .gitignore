# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# --- Secrets (never commit real credentials) ---
.env
*.env
!*.env.example
google-service-account*.json
*credentials*.json
!schemas/*.json
!tests/fixtures/*.json

# --- Runtime artifacts (regenerated every run; do not version) ---
output/*
!output/.gitkeep
state/*.json
!state/.gitkeep
# state/manifest.json IS versioned (see CLAUDE.md "Every run must be
# idempotent") -- daily.yml commits it back to main after every run. The
# broad state/*.json ignore above exists for other stray/local state files,
# not this one; without this exception it silently defeats idempotency.
!state/manifest.json

# --- Gallery site (scripts/build_gallery.py) ---
# gallery/site/ is a build artifact, regenerated on every deploy (see
# ARCHITECTURE.md "Gallery site") -- gallery/images/ is NOT ignored; those
# PNGs are the gallery's durable, committed source data.
gallery/site/

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# --- Claude Code local state (never share session data) ---
.claude/settings.local.json
