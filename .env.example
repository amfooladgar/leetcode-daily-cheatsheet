# Copy this file to .env for LOCAL development only.
# In production (GitHub Actions) these are set as encrypted repository secrets
# under Settings -> Secrets and variables -> Actions. NEVER commit a real .env file.

# --- Anthropic (Claude Code, used headless via `claude -p`) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Google Drive (OAuth user credentials, not a service account --- see
# ARCHITECTURE.md "Why OAuth instead of a service account"). Get these by
# running `python scripts/authorize_google_drive.py` once (docs/SETUP.md
# step 3) after creating an OAuth Client ID in Google Cloud Console.
GOOGLE_OAUTH_CLIENT_ID=put-the-oauth-client-id-here
GOOGLE_OAUTH_CLIENT_SECRET=put-the-oauth-client-secret-here
GOOGLE_OAUTH_REFRESH_TOKEN=put-the-refresh-token-from-the-authorize-script-here
GOOGLE_DRIVE_FOLDER_ID=put-the-posts-folder-id-here

# --- Telegram (Bot API — see docs/SETUP.md step 3.5). Message @BotFather
# on Telegram and run /newbot for the token; message the bot once (or add
# it as admin to a channel) and hit
# https://api.telegram.org/bot<TOKEN>/getUpdates to read back the chat ID. ---
TELEGRAM_BOT_TOKEN=put-the-botfather-token-here
TELEGRAM_CHAT_ID=put-your-chat-or-channel-id-here

# --- OpenAI (optional image-generation renderer -- see ARCHITECTURE.md
# "Optional OpenAI image renderer" and docs/SETUP.md. Only required when
# image_generation.provider is "openai" in config/settings.yaml or
# IMAGE_GENERATION_PROVIDER=openai / --image-provider openai is set; the
# default "existing" renderer never reads this. ---
OPENAI_API_KEY=

# --- Optional overrides (defaults live in config/settings.yaml) ---
# CHEATSHEET_MODEL=claude-sonnet-5
# CHEATSHEET_TIMEZONE=America/New_York
# IMAGE_GENERATION_PROVIDER=existing
